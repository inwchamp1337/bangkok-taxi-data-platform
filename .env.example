# =============================================================================
# Bangkok Taxi Data Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.

# -- MinIO (S3-compatible storage) --
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_123
MINIO_ENDPOINT=minio:9000
MINIO_RAW_BUCKET=raw
MINIO_QUARANTINE_BUCKET=quarantine

# -- ClickHouse --
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret
CLICKHOUSE_DB=taxi

# -- Airflow --
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres:5432/airflow
AIRFLOW__WEBSERVER__SECRET_KEY=your-webserver-secret-key
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__LOGGING__BASE_LOG_FOLDER=/opt/airflow/logs

# -- Airflow Metadata Postgres --
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# -- Grafana --
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=grafana_secret
GF_INSTALL_PLUGINS=grafana-clickhouse-datasource

# -- iTIC Data Source --
ITIC_BASE_URL=https://itic.longdo.com/opendata/probe-data
